<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>
<div class="cardapio">
    <h3>Cardápio</h3>
    <p>Escolha seu sabor favorito, combine com sua bebida preferida e aproveite uma experiência cheia de sabor! ❤️</p>
    <p><strong>Bom apetite!</strong></p>
    <div class="tabelas-container">
 <table class="tabela-cardapio">
    <thead>
      <tr>
        <th>Pizza</th>
        <th>Nome</th>
        <th>Preço</th>
      </tr>
    </thead>
      <tbody>
        <% cardapios.forEach((pizza) => { %>
            <tr>
                <td>
                    <img src="/images/<%= pizza.image %>"
                         alt="<%= pizza.nome %>">
                </td>
                <td><%= pizza.nome %></td>
                <td>R$ <%= Number(pizza.preco).toFixed(2).replace(".", ",") %></td>
            </tr>
        <% }) %>
    </tbody>
  </table>
     <table class="tabela-cardapio">
    <thead>
      <tr>
        <th>Bebida</th>
        <th>Nome</th>
        <th>Preço</th>
      </tr>
    </thead>
    <tbody>
        <% bebidas.forEach((bebida) => { %>
            <tr>
                <td>
                    <img src="/images/<%= bebida.image %>" alt="<%= bebida.nome %>">
                </td>
                <td><%= bebida.nome %></td>
                <td>R$ <%= Number(bebida.preco).toFixed(2).replace(".", ",") %></td>
            </tr>
        <% }) %>
    </tbody>
  </table>
</div>
  <a href="/contato" class="botao-pedir">Peça ja!</a>
</div>
<%- include ('partials/footer.ejs') %>