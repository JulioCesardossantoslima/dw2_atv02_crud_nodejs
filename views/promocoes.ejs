<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>
<div class="promocoes">
<div class="heroPromo">
    <h3>Promoções imperdiveis!</h3>
   <h4 class="h4promo">Descontos imprecionantes!!<br>
    Peça agora e economize mais do que nunca!
   </h4>
    <a href="#promos"  class="btn btn-danger btn-lg" id="botaopromo">Ver Promoções!</a>
</div>
<div class="promocao" id="promos">
    <div class="eco-local">
      <h3>Promoções Especiais </h3>
      <p>Aproveite condições especiais para curtir sua pizza quentinha! Essas promoções são pensadas para quem quer viver a experiência completa, saborear cada fatia fresquinha e aproveitar o clima da pizzaria.</p>
<table class="tabela-promolocal">
  <thead>
    <tr>
      <th>Promoção</th>
      <th>Descrição</th>
      <th>Preço</th>
    </tr>
  </thead>
  <tbody>
    <% promocoes.forEach(function(item) { %>
      <tr>
        <td><%= item.nome %></td>
        <td><%= item.descricao %></td>
        <td><%= item.preco %></td>
      </tr>
    <% }); %>
  </tbody>
</table>
    </div>
</div>
</div>
<%- include ('partials/footer.ejs') %>